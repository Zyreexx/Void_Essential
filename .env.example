# ==============================================================================
# VOID ESSENTIALS - Environment Configuration Template
# ==============================================================================

# Flask Backend Configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-in-production-to-a-secure-random-key-32-chars
PORT=5001

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL=sqlite:///void_store.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/void_essentials

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-in-production-to-a-secure-string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Third-Party Service Placeholders (Configure with live keys for production)
# STRIPE_SECRET_KEY=sk_test_placeholder_key
# STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=placeholder_user
# SMTP_PASS=placeholder_pass

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_STORE_NAME="VOID ESSENTIALS"
NEXT_PUBLIC_SUPPORT_EMAIL="support@voidessentials.store"
